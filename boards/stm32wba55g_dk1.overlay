/*
 * STM32WBA55G-DK1: USART2 als Bridge-UART verwenden.
 *
 * USART2 liegt auf freien Pins:
 *   PB0  = USART2_TX -> ARDUINO D1, ebenso STMod+ CN12 (JP2 = ON)
 *   PA11 = USART2_RX -> ARDUINO D0, ebenso STMod+ CN12 (JP2 = ON)
 * USART1 (PB12/PA8, ST-LINK VCP) bleibt fuer Konsole/Logging frei.
 */

/ {
	aliases {
		bridge-uart = &usart2;
	};
};

&usart2 {
	status = "okay";
	current-speed = <115200>;
};
